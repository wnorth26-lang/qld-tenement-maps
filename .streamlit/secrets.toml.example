# Template only - do NOT put real credentials in this file or commit real ones anywhere.
#
# Locally: copy this to .streamlit/secrets.toml (already gitignored) and fill in real values.
# On Streamlit Community Cloud: paste the filled-in contents into
#   your app's dashboard -> Settings -> Secrets
# instead - the platform stores them securely and injects them at runtime; nothing sensitive
# ever needs to touch the GitHub repo.

[smtp]
host = "smtp.example.com"
port = 465
user = "you@example.com"
password = "app-specific-password"
from = "you@example.com"
